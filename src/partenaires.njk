<form class="devis-form pt-form" id="pt-form" action="/api/devis" method="post" novalidate>
<div class="f-row">
<label class="f-field"><span>Prénom</span><input name="prenom" autocomplete="given-name" required></label>
<label class="f-field"><span>Nom du lieu ou de l'agence</span><input name="lieu" autocomplete="organization" required></label>
</div>
<div class="f-row">
<label class="f-field"><span>E-mail</span><input name="email" type="email" autocomplete="email" inputmode="email" required></label>
<label class="f-field"><span>Téléphone <small>facultatif</small></span><input name="telephone" type="tel" autocomplete="tel" inputmode="tel"></label>
</div>
<div class="f-row">
<label class="f-field"><span>Vous êtes</span><select name="profil">
<option>Lieu de réception</option><option>Wedding planner</option><option>Photographe ou vidéaste</option><option>Traiteur</option><option>DJ</option><option>Autre</option>
</select></label>
<label class="f-field"><span>Mariages par an <small>environ</small></span><select name="volume">
<option>Moins de 10</option><option>10 à 30</option><option>30 à 60</option><option>Plus de 60</option>
</select></label>
</div>
<label class="f-field"><span>Message <small>facultatif</small></span><textarea name="message" rows="3" placeholder="Vos questions, vos disponibilités pour un appel…"></textarea></label>
<input type="hidden" name="service" value="partenariat">
<label class="f-trap" aria-hidden="true">Site web<input name="site_web" tabindex="-1" autocomplete="off"></label>
<p class="f-error" id="pt-error" role="alert" hidden></p>
<button class="btn primary f-submit" type="submit" data-track="partenaire-envoi">Devenir partenaire</button>
<p class="f-note">Réponse sous {{ site.delaiReponse }}. Sans engagement.</p>
</form>
</div></section>

<script>
(function () {
  // Simulateur de marge (Signature, prix partenaire 400 €)
  var c = document.getElementById("pt-calc");
  if (c) {
    var eur = function (n) { return Math.round(n).toLocaleString("fr-FR") + " €"; };
    var maj = function () {
      var m = +c.elements.mariages.value, p = +c.elements.part.value, prix = Math.max(400, +c.elements.prix.value || 400);
      var n = Math.round(m * p / 100), unit = prix - 400;
      c.querySelector('[data-out="mariages"]').textContent = m;
      c.querySelector('[data-out="part"]').textContent = p + " %";
      c.querySelector('[data-out="marge"]').textContent = eur(n * unit);
      c.querySelector('[data-out="detail"]').textContent = n + " mariage" + (n > 1 ? "s" : "") + " × " + eur(unit) + " par an";
    };
    c.addEventListener("input", maj); maj();
  }
  // Formulaire partenaire : même envoi que la page devis
  var f = document.getElementById("pt-form"), err = document.getElementById("pt-error");
  if (!f) return;
  f.addEventListener("submit", function (e) {
    e.preventDefault();
    err.hidden = true;
    var manquants = ["prenom", "lieu", "email"].filter(function (k) { return !f.elements[k].checkValidity() || !f.elements[k].value.trim(); });
    if (manquants.length) { err.textContent = "Merci d'indiquer votre prénom, le nom de votre lieu et un e-mail valide."; err.hidden = false; f.elements[manquants[0]].focus(); return; }
    var btn = f.querySelector(".f-submit"), libelle = btn.textContent;
    btn.disabled = true; btn.textContent = "Envoi…";
    fetch(f.action, { method: "POST", headers: { "Content-Type": "application/json", "Accept": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(f))) })
      .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
      .then(function (d) {
        if (!d.ok) throw new Error("envoi");
        var done = false, go = function () { if (!done) { done = true; location.href = "/merci/"; } };
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "generate_lead", evenement: "Partenariat", formule: f.elements.profil.value, eventCallback: go, eventTimeout: 800 });
        setTimeout(go, 900);
      })
      .catch(function () {
        btn.disabled = false; btn.textContent = libelle;
        err.innerHTML = 'L\'envoi n\'a pas fonctionné. Réessayez, ou écrivez-nous à <a href="mailto:{{ site.email }}">{{ site.email }}</a>.';
        err.hidden = false;
      });
  });
})();
</script>

