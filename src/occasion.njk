---
layout: layouts/base.njk
pagination:
  data: occasions
  size: 1
  alias: o
permalink: "{{ o.url }}"
---
{% set livre = services | findBySlug("livre-dor-audio-video") %}
{% set evt = evenements | findBySlug(o.evenement) %}
{% set crumbs = [{ nom: "Livre d'or audio et vidéo", url: livre.url }, { nom: o.nom }] %}
{% set heroImg = evt.image if evt else livre.image %}{% set heroAlt = o.h1 %}{% set heroEyebrow = "Livre d'or audio et vidéo · " + o.nom %}
{% set heroTitle = o.h1 %}{% set heroIntro = o.enBref %}
{% set heroAside %}
<div class="price-box"><strong>Dès {{ livre.prix | euros }}</strong><span>livraison et installation comprises</span></div>
<div class="btns"><a class="btn sage" href="/devis/?service=livre-dor-audio-video&evenement={{ o.evenement }}" data-track="devis">Vérifier ma date</a><a class="btn ghost" href="#formules">Voir les formules</a></div>
{% endset %}
{% include "partials/hero-full.njk" %}
{% include "partials/crumbs.njk" %}

<section class="section"><div class="wrap two-cols">
<div>
<h2>Pourquoi un livre d'or audio pour {{ "un mariage" if o.slug == "mariage" else ("un anniversaire" if o.slug == "anniversaire" else ("un baptême" if o.slug == "bapteme" else "votre entreprise")) }} ?</h2>
{% for p in o.pourquoi %}<p>{{ p }}</p>{% endfor %}
</div>
<div class="box">
<h3>Comment vos invités l'utilisent</h3>
<p style="margin:0;">{{ o.usage }}</p>
</div>
</div></section>

<section class="section alt"><div class="wrap">
<h2>Exemples de messages d'accueil</h2>
<p class="lede" style="margin-bottom:32px;">C'est ce que vos invités entendent en décrochant. Enregistrez le vôtre, ou inspirez-vous de ceux-ci.</p>
<div class="avis-grid">{% for m in o.messagesAccueil %}<figure class="avis"><blockquote>{{ m }}</blockquote></figure>{% endfor %}</div>
</div></section>

<section class="section"><div class="wrap two-cols">
<div>
<h2>Idées de messages à faire laisser</h2>
<p>Certains invités ne savent pas quoi dire. Une petite affiche avec quelques idées suffit à les lancer :</p>
<ul class="check">{% for i in o.idees %}<li>{{ i }}</li>{% endfor %}</ul>
</div>
<div class="box">
<h3>Logistique le jour J</h3>
<p style="margin:0;">{{ o.logistique }}</p>
</div>
</div></section>

<section class="section alt" id="formules"><div class="wrap">
<h2>Formules et tarifs</h2>
<p class="lede" style="margin-bottom:32px;">Trois formules, livraison et installation comprises à Paris et en Île-de-France.</p>
{% include "partials/formules-livre.njk" %}
<div class="btns"><a class="btn" href="{{ livre.url }}">Tout savoir sur le livre d'or</a><a class="btn ghost" href="/location-livre-d-or-audio/">Conditions de location</a></div>
</div></section>

<section class="section"><div class="wrap" style="max-width:820px;">
<h2>Vos questions</h2>
{% set faq = o.faq %}{% include "partials/faq.njk" %}
</div></section>

{% set avisService = "livre-dor-audio-video" %}{% include "partials/avis.njk" %}

<section class="section alt"><div class="wrap">
<h2>Le livre d'or pour d'autres occasions</h2>
<div class="pills" style="margin-top:20px;">{% for x in occasions %}{% if x.slug != o.slug %}<a class="pill" href="{{ x.url }}">{{ x.nom }}</a>{% endif %}{% endfor %}
{% if evt %}<a class="pill" href="/evenements/{{ evt.slug }}/">Toutes nos animations : {{ evt.nom | lower }}</a>{% endif %}</div>
</div></section>

{% set devisParam = "service=livre-dor-audio-video&evenement=" + o.evenement %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in o.faq %}{"@type":"Question","name":{{ f.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Livre d'or audio et vidéo","item":"{{ site.url }}{{ livre.url }}"},{"@type":"ListItem","position":3,"name":{{ o.nom | json | safe }}}]}
</script>
