---
layout: layouts/base.njk
pagination:
  data: occasions
  size: 1
  alias: o
permalink: "{{ o.url }}"
---
{% set livre = services | findBySlug("livre-dor-audio-video") %}
{% set evt = evenements | findBySlug(o.evenement) %}
{% set crumbs = [{ nom: "Livre d'or audio et vidéo", url: livre.url }, { nom: o.nom }] %}
{% set heroImg = evt.image if evt else livre.image %}{% set heroAlt = o.h1 %}{% set heroEyebrow = "Livre d'or audio & vidéo · " + o.nom %}
{% set heroTitle = o.h1 %}{% set heroIntro = o.intro %}
{% set heroAside %}<div class="btns" style="margin-top:0;"><a class="btn primary" href="/devis/?service=livre-dor-audio-video&evenement={{ o.evenement }}" data-track="devis">Vérifier ma date</a></div>{% endset %}
{% include "partials/hero-full.njk" %}

<section class="section statement"><div class="wrap">
<p>{{ o.punchline }}</p>
</div></section>

<section class="section" style="padding-top:0;"><div class="wrap split-lead">
<h2>Pourquoi un livre d'or audio pour {{ "un mariage" if o.slug == "mariage" else ("un anniversaire" if o.slug == "anniversaire" else ("un baptême" if o.slug == "bapteme" else "votre entreprise")) }} ?</h2>
<div><p>{{ o.enBref }}</p></div>
</div></section>

<section class="section" style="padding-top:0;"><div class="wrap split-lead">
<h2>Le jour J</h2>
<div><p>{{ o.usage }}</p><p>{{ o.logistique }}</p></div>
</div></section>

<section class="section alt"><div class="wrap">
<h2>Exemples de messages d'accueil</h2>
<div class="quotes">{% for m in o.messagesAccueil %}<blockquote>{{ m }}</blockquote>{% endfor %}</div>
</div></section>

<section class="section"><div class="wrap split-lead">
<h2>Idées de messages</h2>
<div><ul class="inline-list" style="flex-direction:column;">{% for i in o.idees %}<li>{{ i }}</li>{% endfor %}</ul>
<p style="margin-top:var(--s5);font-size:var(--fs-small);"><a href="/blog/idees-livre-d-or-original/">Plus d'idées de livre d'or original</a></p></div>
</div></section>

<section class="section alt" id="formules"><div class="wrap">
<h2 class="center">Formules et tarifs</h2>
{% include "partials/formules-min.njk" %}
</div></section>

{% set faq = o.faq %}{% include "partials/faq-section.njk" %}

{% set avisService = "livre-dor-audio-video" %}{% include "partials/avis.njk" %}

<section class="section" style="padding-top:0;"><div class="wrap">
<ul class="inline-list">{% for x in occasions %}{% if x.slug != o.slug %}<li><a href="{{ x.url }}">Livre d'or {{ x.nom | lower }}</a></li>{% endif %}{% endfor %}<li><a href="/location-livre-d-or-audio/">Location de livre d'or audio en Île-de-France</a></li></ul>
</div></section>

{% set devisParam = "service=livre-dor-audio-video&evenement=" + o.evenement %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in o.faq %}{"@type":"Question","name":{{ f.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Livre d'or audio et vidéo","item":"{{ site.url }}{{ livre.url }}"},{"@type":"ListItem","position":3,"name":{{ o.nom | json | safe }}}]}
</script>
