---
layout: layouts/base.njk
pagination:
  data: occasions
  size: 1
  alias: o
permalink: "{{ o.url }}"
---
{% set livre = services | findBySlug("livre-dor-audio-video") %}
{% set evt = evenements | findBySlug(o.evenement) %}
{% set crumbs = [{ nom: "Livre d'or audio et vidéo", url: livre.url }, { nom: o.nom }] %}
{% set heroImg = evt.image if evt else livre.image %}{% set heroAlt = o.h1 %}{% set heroEyebrow = "Livre d'or audio & vidéo · " + o.nom %}
{% set heroTitle = o.h1 %}{% set heroIntro = o.intro %}
{% set heroAside %}<div class="btns u-mt0"><a class="btn primary" href="/devis/?service=livre-dor-audio-video&evenement={{ o.evenement }}" data-track="devis">Réserver ma date</a></div>{% endset %}
{% include "partials/hero-full.njk" %}

<section class="section statement"><div class="wrap">
<p>{{ o.punchline }}</p>
</div></section>

<section class="section u-pt0"><div class="wrap split-lead">
<h2>Pourquoi un livre d'or audio pour {{ "un mariage" if o.slug == "mariage" else ("un anniversaire" if o.slug == "anniversaire" else ("un baptême" if o.slug == "bapteme" else "votre entreprise")) }} ?</h2>
<div><p>{{ o.enBref }}</p></div>
</div></section>

<section class="section u-pt0"><div class="wrap split-lead">
<h2>Le jour J</h2>
<div><p>{{ o.usage }}</p><p>{{ o.logistique }}</p></div>
</div></section>

<section class="section u-pt0"><div class="wrap">
<div class="trio">
<div class="trio-item">{% set label = "Le téléphone vintage" %}{% set img = livre.image %}{% set imgAlt = livre.imageAlt %}{% set tall = false %}{% include "partials/visual.njk" %}{% set imgAlt = false %}<div><span class="trio-num">01</span><h3>On installe</h3><p>Le téléphone vintage, posé là où vos invités passent, vérifié avant leur arrivée.</p></div></div>
<div class="trio-item">{% set label = "Le message d'accueil" %}{% set img = livre.imageMessage %}{% set imgAlt = livre.imageMessageAlt %}{% include "partials/visual.njk" %}{% set imgAlt = false %}<div><span class="trio-num">02</span><h3>Vos invités décrochent</h3><p>Votre message d'accueil, le bip, et ils vous parlent.</p></div></div>
<div class="trio-item">{% set label = "Vos souvenirs" %}{% set img = livre.imageSouvenirs %}{% set imgAlt = livre.imageSouvenirsAlt %}{% include "partials/visual.njk" %}{% set imgAlt = false %}<div><span class="trio-num">03</span><h3>Vous réécoutez</h3><p>Tous les messages en téléchargement sous 2 semaines.</p></div></div>
</div>
</div></section>

<section class="section alt"><div class="wrap">
<h2>Exemples de messages d'accueil</h2>
<div class="quotes">{% for m in o.messagesAccueil %}<blockquote>{{ m }}</blockquote>{% endfor %}</div>
</div></section>

<section class="section"><div class="wrap split-lead">
<h2>{{ o.ideesTitre or "Idées de messages" }}</h2>
<div><ul class="inline-list" style="flex-direction:column;">{% for i in o.idees %}<li>{{ i }}</li>{% endfor %}</ul>
<p class="u-mt5 u-small"><a href="/blog/idees-livre-d-or-original/">Plus d'idées de livre d'or original</a>{% if o.slug == "mariage" %} · <a href="/blog/idees-animation-mariage/">18 idées d'animation mariage</a>{% endif %}</p></div>
</div></section>

<section class="section alt" id="formules"><div class="wrap">
<div class="section-title"><span class="eyebrow">À partir de 200 €</span><h2>Formules et tarifs</h2><p>Livraison et installation comprises à Paris et en Île-de-France.</p></div>
{% include "partials/formules-zigzag.njk" %}
</div></section>

{% set faq = o.faq %}{% include "partials/faq-section.njk" %}

{% set avisService = "livre-dor-audio-video" %}{% include "partials/avis.njk" %}

<section class="section u-pt0"><div class="wrap">
<ul class="inline-list">{% for x in occasions %}{% if x.slug != o.slug %}<li><a href="{{ x.url }}">Livre d'or {{ x.nom | lower }}</a></li>{% endif %}{% endfor %}<li><a href="/location-livre-d-or-audio/">Location de livre d'or audio en Île-de-France</a></li></ul>
</div></section>

{% set devisParam = "service=livre-dor-audio-video&evenement=" + o.evenement %}
{% if o.slug == "mariage" %}{% include "partials/lead-checklist.njk" %}{% endif %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in o.faq %}{"@type":"Question","name":{{ f.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Livre d'or audio et vidéo","item":"{{ site.url }}{{ livre.url }}"},{"@type":"ListItem","position":3,"name":{{ o.nom | json | safe }}}]}
</script>
