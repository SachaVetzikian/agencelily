<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ meta }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
{% if site.googleVerification %}<meta name="google-site-verification" content="{{ site.googleVerification }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ meta }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/og/og-default.png' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<meta name="theme-color" content="#f8f6f2">
<link rel="preload" href="/assets/fonts/instrument-serif-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/fonts/fonts.css">
<link rel="stylesheet" href="/assets/style.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "{{ site.url }}/#business",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}/",
      "logo": "{{ site.url }}/assets/logo-wordmark.png",
      "image": "{{ site.url }}/assets/og/og-default.png",
      "description": "Location de livre d'or audio et vidéo sur téléphone vintage, livré et installé à Paris et en Île-de-France, et animations pour vos événements.",
      "email": "{{ site.email }}",{% if site.phone %}
      "telephone": "{{ site.phone }}",{% endif %}
      "priceRange": "€€",
      "areaServed": [
        {"@type": "City", "name": "Paris"},
        {"@type": "AdministrativeArea", "name": "Hauts-de-Seine"},
        {"@type": "AdministrativeArea", "name": "Seine-Saint-Denis"},
        {"@type": "AdministrativeArea", "name": "Val-de-Marne"},
        {"@type": "AdministrativeArea", "name": "Seine-et-Marne"},
        {"@type": "AdministrativeArea", "name": "Yvelines"},
        {"@type": "AdministrativeArea", "name": "Essonne"},
        {"@type": "AdministrativeArea", "name": "Val-d'Oise"}
      ],{% if site.googleBusiness %}
      "hasMap": "{{ site.googleBusiness }}",{% endif %}{% set same = [] %}{% if site.googleBusiness %}{% set same = (same.push(site.googleBusiness), same) %}{% endif %}{% if site.instagram %}{% set same = (same.push(site.instagram), same) %}{% endif %}{% if same.length %}
      "sameAs": {{ same | json | safe }},{% endif %}
      "knowsAbout": ["Livre d'or audio", "Livre d'or vidéo", "Location de téléphone livre d'or", "Animation de mariage"]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "{{ site.name }}",
      "inLanguage": "fr-FR",
      "publisher": {"@id": "{{ site.url }}/#business"}
    }
  ]
}
</script>
</head>
<body>
{% include "partials/header.njk" %}
<main>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% include "partials/contact-bar.njk" %}
{% include "partials/analytics.njk" %}
</body>
</html>
