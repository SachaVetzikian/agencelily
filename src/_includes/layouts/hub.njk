---
layout: layouts/base.njk
---
{% set crumbs = [{ nom: hubNom }] %}
{% set first = (services | byCategorie(categorie))[0] %}
{% set heroImg = first.image %}{% set heroAlt = hubNom %}{% set heroEyebrow = eyebrow %}{% set heroTitle = h1 %}{% set heroIntro = lede %}
{% set heroAside %}<div class="btns"><a class="btn primary" href="/devis/" data-track="devis">Vérifier ma date</a><a class="btn ghost" href="/configurateur/">Simuler mon budget</a></div>{% endset %}
{% include "partials/hero-full.njk" %}
<section class="section">
<div class="wrap">
<div class="cards">{% for c in services | byCategorie(categorie) %}{% include "partials/card-service.njk" %}{% endfor %}</div>
</div>
</section>
<section class="section">
<div class="wrap" style="max-width:820px;">
{{ content | safe }}
</div>
</section>
<section class="section alt">
<div class="wrap">
<h2>Pour quel événement ?</h2>
<div class="pills" style="margin-top:20px;">{% for e in evenements %}<a class="pill" href="/evenements/{{ e.slug }}/">{{ e.nom }}</a>{% endfor %}</div>
</div>
</section>
{% include "partials/cta.njk" %}
