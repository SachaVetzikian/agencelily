---
layout: layouts/base.njk
---
{% set crumbs = [{ nom: hubNom }] %}
{% include "partials/crumbs.njk" %}
<section class="hero">
<div class="wrap">
<span class="eyebrow">{{ eyebrow }}</span>
<h1>{{ h1 }}</h1>
<p class="lede">{{ lede }}</p>
</div>
</section>
<section class="section alt">
<div class="wrap">
<div class="cards">{% for c in services | byCategorie(categorie) %}{% include "partials/card-service.njk" %}{% endfor %}</div>
</div>
</section>
<section class="section">
<div class="wrap" style="max-width:820px;">
{{ content | safe }}
</div>
</section>
<section class="section alt">
<div class="wrap">
<h2>Pour quel événement ?</h2>
<div class="pills" style="margin-top:20px;">{% for e in evenements %}<a class="pill" href="/evenements/{{ e.slug }}/">{{ e.nom }}</a>{% endfor %}</div>
</div>
</section>
{% include "partials/cta.njk" %}
