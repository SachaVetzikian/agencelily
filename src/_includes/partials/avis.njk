{# Avis clients réels (src/_data/avis.json). Filtrés par service si "avisService" est défini. Jamais d'avis inventés. #}
{% set liste = [] %}
{% for a in avis %}{% if not avisService or (a.services and avisService in a.services) %}{% set liste = (liste.push(a), liste) %}{% endif %}{% endfor %}
{% if liste.length %}
<section class="section">
<div class="wrap">
<span class="eyebrow"><span class="stars">★★★★★</span> {{ site.avis.nombre }} avis Google</span>
<h2>Ce qu'en disent nos clients</h2>
<div class="avis-grid" style="margin-top:28px;">
{% for a in liste | batch(6) | first %}<figure class="avis">
<div class="stars" aria-label="{{ a.note or 5 }} sur 5">{% for i in range(0, a.note or 5) %}★{% endfor %}</div>
<blockquote>{{ a.texte }}</blockquote>
<figcaption><strong>{{ a.prenom }}</strong>{% if a.evenement %} · {{ a.evenement }}{% endif %}{% if a.date %} · {{ a.date }}{% endif %}</figcaption>
</figure>{% endfor %}
</div>
{% if site.avis.lien %}<div class="btns"><a class="btn ghost" href="{{ site.avis.lien }}" rel="noopener" target="_blank">Tous les avis sur Google</a></div>{% endif %}
</div>
</section>
{% endif %}
