{# Carrousel de moments au format vidéo verticale (données : src/_data/moments.json) #}
<section class="section moments-section"><div class="wrap">
<div class="section-title"><span class="eyebrow">Ils ont décroché</span><h2>Des moments à garder</h2></div>
<div class="moments">
{% for m in moments %}<figure class="moment"><img src="{{ m.img }}" alt="{{ m.alt }}" loading="lazy"><figcaption>{{ m.texte }}</figcaption></figure>{% endfor %}
</div>
<div class="btns" style="justify-content:center;"><a class="btn primary" href="/devis/?service=livre-dor-audio-video" data-track="devis-moments">Réserver ma date</a></div>
</div></section>
