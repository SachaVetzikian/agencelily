{# Avis Google au style Google Maps (src/_data/avis.json). Les avis de l'équipe (site.avis.exclus) ne sont jamais affichés. Jamais d'avis inventés. #}
{% set exclus = site.avis.exclus or [] %}
{% set listeG = [] %}{% for a in avis %}{% if not (a.prenom in exclus) %}{% set listeG = (listeG.push(a), listeG) %}{% endif %}{% endfor %}
{% if listeG.length %}
<section class="section{% if avisAlt %} alt{% endif %} gavis-sec"><div class="wrap">
<div class="gavis-head">
<div class="gavis-brand">
<svg class="gavis-maps" viewBox="0 0 24 34" aria-hidden="true"><defs><clipPath id="gm-pin"><path d="M12 0C5.37 0 0 5.37 0 12c0 8.6 12 22 12 22s12-13.4 12-22C24 5.37 18.63 0 12 0z"/></clipPath></defs><g clip-path="url(#gm-pin)"><rect width="24" height="34" fill="#34A853"/><path d="M0 0h13L0 15z" fill="#4285F4"/><path d="M13 0h11v14L8 30z" fill="#EA4335"/><path d="M24 14v20H6z" fill="#FBBC04"/></g><circle cx="12" cy="12" r="4.4" fill="#fff"/></svg>
<div><span class="gavis-label">Avis Google Maps</span>
<div class="gavis-score"><strong>{{ site.avis.note | noteFr }}</strong><span class="gstars" aria-label="{{ site.avis.note | noteFr }} sur 5">★★★★★</span></div>
<span class="gavis-count">{{ site.avis.nombre }} avis · Agence Lily</span></div>
</div>
<div class="gavis-title"><span class="eyebrow">{{ avisEyebrow or "Ils l'ont vécu" }}</span><h2>{{ avisTitre or "Ce qu'en disent les invités" }}</h2></div>
{% if site.avis.lien %}<a class="btn ghost gavis-btn" href="{{ site.avis.lien }}" rel="noopener" target="_blank" data-track="avis-google">Voir sur Google Maps</a>{% endif %}
</div>
<div class="gavis-grid">
{% for a in listeG %}<figure class="gavis">
<div class="gavis-top">
<span class="gavis-avatar" style="background:{{ ['#7a6558','#4285F4','#34A853','#EA4335','#a1887f','#5f6368'][loop.index0 % 6] }}">{{ a.prenom | first }}</span>
<div><strong>{{ a.prenom }}</strong><span>{% if a.evenement %}{{ a.evenement }} · {% endif %}{{ a.date }}</span></div>
<svg class="gavis-g" viewBox="0 0 48 48" aria-label="Google"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
</div>
<div class="gstars" aria-label="{{ a.note or 5 }} sur 5">{% for i in range(0, a.note or 5) %}★{% endfor %}</div>
<blockquote>{{ a.texte }}</blockquote>
</figure>{% endfor %}
</div>
</div></section>
{% endif %}
