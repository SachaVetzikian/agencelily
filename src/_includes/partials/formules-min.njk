{# Formules minimalistes : nom, prix, une ligne. Lien vers la page produit. #}
{% set livre = services | findBySlug("livre-dor-audio-video") %}
{% set lignes = ["Messages vocaux", "Voix et visages", "On va chercher vos invités"] %}
<div class="formules-min">
{% for f in livre.formules %}<a class="fm{% if f.populaire %} pop{% endif %}" href="/devis/?service=livre-dor-audio-video" data-track="devis">
<span class="tag">{{ f.nom }}</span>
<span class="fm-price">{{ f.prix }} €</span>
<span class="fm-line">{{ lignes[loop.index0] }}</span>
</a>{% endfor %}
</div>
<p class="center fm-note">Lien en ligne inclus · clé USB en option (25 €) · livraison et installation comprises</p>
