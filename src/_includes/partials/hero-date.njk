{# Champ « date de votre événement » du hero : envoie vers le devis prérempli #}
<form class="hero-date" action="/devis/" method="get">
<input type="hidden" name="service" value="livre-dor-audio-video">
<label for="hd-date">Date de votre événement</label>
<div class="hero-date-row"><input id="hd-date" type="date" name="date" required><button class="btn primary" type="submit" data-track="devis-hero">Vérifier ma date</button></div>
</form>
<script>(function(){var d=document.getElementById("hd-date");if(d)d.min=new Date().toISOString().slice(0,10);})();</script>
