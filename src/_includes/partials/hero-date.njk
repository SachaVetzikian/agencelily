{# Champ « date de votre événement » du hero : envoie vers le devis prérempli #}
<form class="hero-date" action="/devis/" method="get">
<input type="hidden" name="service" value="livre-dor-audio-video">
<label for="hd-date">Date de votre événement</label>
<div class="hero-date-row"><input id="hd-date" type="text" name="date" placeholder="jj / mm / aaaa" inputmode="none" autocomplete="off" required onfocus="this.type='date';if(this.showPicker)try{this.showPicker()}catch(e){}" onblur="if(!this.value)this.type='text'"><button class="btn primary" type="submit" data-track="devis-hero">Réserver ma date</button></div>
</form>
<script>(function(){var d=document.getElementById("hd-date");if(d)d.min=new Date().toISOString().slice(0,10);
document.addEventListener("DOMContentLoaded",function(){var bar=document.querySelector(".contact-bar"),f=document.querySelector(".hero-date");
if(bar&&f&&"IntersectionObserver" in window)new IntersectionObserver(function(e){bar.classList.toggle("is-hidden",e[0].isIntersecting);}).observe(f);});})();</script>
