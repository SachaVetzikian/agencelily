{# Hero plein cadre + bandeau d'intro. Variables : heroImg, heroImgMobile (4:5, optionnelle), heroAlt, heroEyebrow, heroTitle, heroIntro ; bloc droit via heroAside (HTML) #}
<section class="hero-full">
{% if heroImg %}<picture>
{% if heroImgMobile %}<source media="(max-width: 700px)" srcset="{{ heroImgMobile }}">{% endif %}
<img src="{{ heroImg }}" alt="{{ heroAlt or heroTitle }}" fetchpriority="high" onerror="this.closest('picture').remove()">
</picture>{% endif %}
<div class="wrap">
{% if heroEyebrow %}<span class="eyebrow">{{ heroEyebrow }}</span>{% endif %}
<h1>{{ heroTitle }}</h1>
</div>
</section>
<section class="intro-band"><div class="wrap">
<p class="lede">{{ heroIntro }}</p>
<div class="intro-aside">{{ heroAside | safe }}</div>
</div></section>
