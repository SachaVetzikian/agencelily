{# Hero plein cadre + bandeau d'intro. Variables : heroImg, heroAlt, heroEyebrow, heroTitle, heroIntro ; bloc droit via heroAside (HTML) #}
<section class="hero-full">
{% if heroImg %}<img src="{{ heroImg }}" alt="{{ heroAlt or heroTitle }}" fetchpriority="high" onerror="this.remove()">{% endif %}
<div class="wrap">
{% if heroEyebrow %}<span class="eyebrow">{{ heroEyebrow }}</span>{% endif %}
<h1>{{ heroTitle }}</h1>
</div>
</section>
<section class="intro-band"><div class="wrap">
<p class="lede">{{ heroIntro }}</p>
<div class="intro-aside">{{ heroAside | safe }}</div>
</div></section>
