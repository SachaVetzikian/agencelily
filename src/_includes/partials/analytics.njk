{# Mesure d'audience.
   - GTM (site.gtmId) : chargé sur toutes les pages en Consent Mode v2, mesure refusée par défaut ; l'accord du visiteur passe analytics_storage à "granted".
   - GA4 direct (site.ga4Id) : utilisé seulement sans GTM, chargé après accord.
   Événements poussés dans le dataLayer : generate_lead (devis envoyé), clic_devis, clic_appel, clic_email, temoignage_ecoute. #}
{% set mesure = site.gtmId or site.ga4Id %}
<script>
window.dataLayer = window.dataLayer || [];
window.lilyTrack = function (name, params) {
  var p = params || {};
  {% if site.gtmId %}var o = { event: name }; for (var k in p) o[k] = p[k]; window.dataLayer.push(o);
  {% else %}try { if (window.gtag) window.gtag("event", name, p); } catch (e) {}{% endif %}
};
document.addEventListener("click", function (e) {
  var el = e.target.closest && e.target.closest("[data-track]");
  if (el && el.tagName !== "BUTTON") window.lilyTrack("clic_" + el.dataset.track.replace(/-/g, "_"), { page: location.pathname });
});
</script>
{% if mesure %}
<div class="consent" id="consent" role="dialog" aria-label="Cookies de mesure d'audience" hidden>
<p>Nous mesurons l'audience du site avec Google Analytics pour l'améliorer. D'accord ?</p>
<div class="consent-btns"><button class="btn" type="button" data-consent="non">Refuser</button><button class="btn primary" type="button" data-consent="oui">Accepter</button></div>
</div>
<script>
(function () {
  var KEY = "lily-consent", box = document.getElementById("consent");
  function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
  function accept() {
    {% if site.gtmId %}gtag("consent", "update", { analytics_storage: "granted" });
    window.dataLayer.push({ event: "consent_granted" });
    {% else %}if (window.gtag) return;
    var s = document.createElement("script"); s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id={{ site.ga4Id }}";
    document.head.appendChild(s);
    window.gtag = function () { dataLayer.push(arguments); };
    gtag("js", new Date());
    gtag("config", "{{ site.ga4Id }}", { anonymize_ip: true });{% endif %}
  }
  function refuse() {
    {% if site.gtmId %}gtag("consent", "update", { analytics_storage: "denied" });{% endif %}
  }
  var c = get();
  if (c === "oui") { {% if not site.gtmId %}accept();{% endif %} } else if (c !== "non") box.hidden = false;
  box.addEventListener("click", function (e) {
    var b = e.target.closest("[data-consent]"); if (!b) return;
    set(b.dataset.consent); box.hidden = true;
    b.dataset.consent === "oui" ? accept() : refuse();
  });
  document.addEventListener("click", function (e) {
    if (e.target.closest("[data-consent-open]")) { e.preventDefault(); box.hidden = false; }
  });
})();
</script>
{% endif %}
