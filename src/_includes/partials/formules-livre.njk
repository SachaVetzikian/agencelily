{# Formules du livre d'or (services.json > livre-dor-audio-video) #}
{% set livre = services | findBySlug("livre-dor-audio-video") %}
<div class="formules">
{% for f in livre.formules %}<div class="formule{% if f.populaire %} pop{% endif %}">
{% if f.populaire %}<span class="badge">La plus choisie</span>{% endif %}
{% set label = "Formule " + f.nom %}{% set img = f.image %}{% set imgAlt = f.imageAlt %}{% set tall = false %}<div class="formule-visual">{% include "partials/visual.njk" %}{% set imgAlt = false %}</div>
<h3>{{ f.nom }}</h3>
<p class="price"><strong>{{ f.prix }} €</strong></p>

<ul class="check">{% for d in f.detail %}<li>{{ d }}</li>{% endfor %}</ul>
</div>{% endfor %}
</div>
<span class="rail-hint">Faites glisser pour comparer →</span>
<div class="box u-mt5">
<h3>Options</h3>
<ul class="options">{% for o in livre.options %}<li><span>{{ o.nom }}</span><b>{{ o.prix }}</b></li>{% endfor %}</ul>
</div>
