<footer class="footer">
<div class="wrap">
<div class="cols">
<div>
<a class="logo" href="/">Agence <span>Lily</span></a>
<p style="margin-top:14px;">{{ site.baseline }}.</p>
<p><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% if site.phone %}<br><a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>{% endif %}</p>
{% if site.instagram or site.googleBusiness %}<p>{% if site.instagram %}<a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a>{% endif %}{% if site.instagram and site.googleBusiness %} · {% endif %}{% if site.googleBusiness %}<a href="{{ site.googleBusiness }}" rel="noopener" target="_blank">Google</a>{% endif %}</p>{% endif %}
</div>
<div>
<h4>Livre d'or audio & vidéo</h4>
<ul>
<li><a href="/livre-d-or-audio-video/">Livre d'or audio et vidéo</a></li>
<li><a href="/location-livre-d-or-audio/">Location en Île-de-France</a></li>
{% for o in occasions %}<li><a href="{{ o.url }}">Livre d'or {{ o.nom | lower }}</a></li>{% endfor %}
</ul>
</div>
<div>
<h4>Autres prestations</h4>
<ul>{% for s in services %}{% if s.slug != "livre-dor-audio-video" %}<li><a href="{{ s | serviceUrl }}">{{ s.nom }}</a></li>{% endif %}{% endfor %}</ul>
<h4 style="margin-top:24px;">Événements</h4>
<ul>{% for e in evenements %}<li><a href="/evenements/{{ e.slug }}/">{{ e.nom }}</a></li>{% endfor %}</ul>
</div>
<div>
<h4>Agence Lily</h4>
<ul>
<li><a href="/configurateur/">Simuler mon budget</a></li>
<li><a href="/tarifs/">Tarifs</a></li>
{% if realisations.length %}<li><a href="/realisations/">Réalisations</a></li>{% endif %}
<li><a href="/blog/">Guides et conseils</a></li>
<li><a href="/a-propos/">À propos</a></li>
<li><a href="/devis/">Devis gratuit</a></li>
</ul>
</div>
</div>
<div class="legal">
<span>© {{ year }} Agence Lily · {{ site.zone }}</span>
<span><a href="/mentions-legales/">Mentions légales</a></span>
</div>
</div>
</footer>
