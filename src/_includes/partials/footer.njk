<footer class="footer">
<div class="wrap">
<div class="cols">
<div>
<a class="logo" href="/">Agence <span>Lily</span></a>
<p style="margin-top:14px;">{{ site.baseline }}.</p>
<p><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% if site.phone %}<br><a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>{% endif %}</p>
</div>
<div>
<h4>Bars gourmands</h4>
<ul>{% for s in services | byCategorie('animations') %}<li><a href="/animations/{{ s.slug }}/">{{ s.nom }}</a></li>{% endfor %}</ul>
</div>
<div>
<h4>Location</h4>
<ul>{% for s in services | byCategorie('location') %}<li><a href="/location/{{ s.slug }}/">{{ s.nom }}</a></li>{% endfor %}</ul>
</div>
<div>
<h4>Événements</h4>
<ul>{% for e in evenements %}<li><a href="/evenements/{{ e.slug }}/">{{ e.nom }}</a></li>{% endfor %}</ul>
</div>
</div>
<div class="legal">
<span>© {{ year }} Agence Lily · {{ site.zone }}</span>
<span><a href="/tarifs/">Tarifs</a> · <a href="/devis/">Devis</a> · <a href="/mentions-legales/">Mentions légales</a></span>
</div>
</div>
</footer>
