{# Barre de contact fixe sur mobile : devis toujours visible, WhatsApp et appel si renseignés dans site.json #}
<div class="contact-bar" role="complementary" aria-label="Contact rapide">
{% if site.whatsapp %}<a class="cb-btn" href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMessage | urlencode }}" rel="noopener" target="_blank" data-track="whatsapp">WhatsApp</a>{% endif %}
{% if site.phone %}<a class="cb-btn" href="tel:{{ site.phone | replace(' ', '') }}" data-track="appel">Appeler</a>{% endif %}
<a class="cb-btn cb-main" href="/devis/" data-track="devis">Vérifier ma date</a>
</div>
{% if site.whatsapp %}<a class="wa-float" href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMessage | urlencode }}" rel="noopener" target="_blank" aria-label="Nous écrire sur WhatsApp" data-track="whatsapp"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.8-.4-1.6-.8-2.4-2-.2-.3.2-.3.6-1 .1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg></a>{% endif %}
