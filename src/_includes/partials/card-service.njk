<a class="card" href="{{ c | serviceUrl }}">
{% set label = c.nom %}{% set img = c.image %}{% set tall = false %}{% include "partials/visual.njk" %}
<div class="body">
<span class="tag">{% if c.categorie == 'animations' %}Bar gourmand{% else %}Location{% endif %}</span>
<h3>{{ c.nom }}</h3>
<p>{{ c.court }}</p>
<div class="card-foot"><span class="price">Dès {{ c.prix | euros }}</span><span class="btn small">Découvrir</span></div>
</div>
</a>
