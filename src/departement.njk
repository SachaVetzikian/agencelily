---
layout: layouts/base.njk
pagination:
  data: departements
  size: 1
  alias: d
permalink: "/mariage/{{ d.slug }}/"
---
{% set mariage = evenements | findBySlug("mariage") %}
{% set crumbs = [{ nom: "Mariage", url: "/evenements/mariage/" }, { nom: d.nom + " (" + d.code + ")" }] %}

{% set heroImg = mariage.image %}{% set heroAlt = ("Mariage " + d.nom) %}{% set heroEyebrow = ("Mariage · " + d.nom + " (" + d.code + ")") %}
{% set heroTitle = ("Animation mariage " + d.nom + " (" + d.code + ")") %}{% set heroIntro = d.intro %}
{% set heroAside %}
<div class="btns"><a class="btn sage" href="/devis/?evenement=mariage" data-track="devis">Vérifier ma date</a><a class="btn ghost" href="/configurateur/">Simuler mon budget</a></div>
{% endset %}
{% include "partials/hero-full.njk" %}
{% include "partials/crumbs.njk" %}

<section class="section"><div class="wrap two-cols">
<div>
<h2>Les lieux de mariage {{ d.en }}</h2>
<p>{{ d.lieux }}</p>
<p>{{ d.conseil }}</p>
</div>
<div class="box">
<h3>Nous intervenons notamment à</h3>
<ul class="check">{% for v in d.villes %}<li>{{ v }}</li>{% endfor %}</ul>
<p style="margin:16px 0 0;color:var(--muted);font-size:15px;">Et dans toutes les communes du département. Frais de déplacement indiqués dans le devis.</p>
</div>
</div></section>

<section class="section alt"><div class="wrap">
<h2>Nos animations pour votre mariage</h2>
<div class="reco" style="margin-top:24px;">
{% for r in mariage.services %}{% set x = services | findBySlug(r.slug) %}<a href="/{{ x.categorie }}/{{ x.slug }}/"><div><span class="tag">{% if x.categorie == 'animations' %}Bar gourmand{% else %}Location{% endif %}</span><h3 style="margin:4px 0 0;">{{ x.nom }}</h3><p>{{ r.pourquoi }}</p></div><span class="price" style="padding:0;white-space:nowrap;">Dès {{ x.prix | euros }}</span></a>
{% endfor %}
</div>
</div></section>

<section class="section"><div class="wrap">
<div class="pack">
<div><span class="eyebrow">Le plus simple</span><h2>{{ mariage.pack.nom }}</h2>
<ul class="check">{% for c in mariage.pack.contenu %}<li>{{ c }}</li>{% endfor %}</ul></div>
<div><div class="amount"><s>{{ mariage.pack.valeur | euros }}</s>{{ mariage.pack.prix | euros }}</div>
<p>Livré et installé {{ d.en }}, un seul devis, une seule équipe.</p>
<a class="btn" href="/devis/?evenement=mariage&pack=1">Réserver ce pack</a></div>
</div>
</div></section>

<section class="section alt"><div class="wrap" style="max-width:820px;">
<h2>Vos questions sur un mariage {{ d.en }}</h2>
{% set faq = d.faq.concat(mariage.faq) %}{% include "partials/faq.njk" %}
</div></section>

<section class="section"><div class="wrap">
<h2>Nous intervenons aussi en</h2>
<div class="pills" style="margin-top:20px;">{% for o in departements %}{% if o.slug != d.slug %}<a class="pill" href="/mariage/{{ o.slug }}/">{{ o.nom }} ({{ o.code }})</a>{% endif %}{% endfor %}</div>
</div></section>

{% set devisParam = "evenement=mariage" %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Service","name":"Animation mariage {{ d.nom }}","serviceType":"Animation de mariage","url":"{{ site.url }}{{ page.url }}","areaServed":{"@type":"AdministrativeArea","name":{{ (d.nom + " (" + d.code + ")") | json | safe }}},"provider":{"@type":"LocalBusiness","name":"{{ site.name }}","url":"{{ site.url }}/"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in d.faq.concat(mariage.faq) %}{"@type":"Question","name":{{ f.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
