{% set crumbs = [{ nom: "Guides" }] %}
{% set heroImg = "/assets/photos/hero-blog.webp" %}{% set heroAlt = "Téléphone vintage en cuivre posé sur une table" %}{% set heroEyebrow = "Guides et conseils" %}
{% set heroTitle = "Guides du livre d’or audio et vidéo" %}
{% set heroIntro = "Fonctionnement, idées, prix. Tout pour choisir et réussir votre livre d’or audio." %}
{% include "partials/hero-full.njk" %}
<section class="blog-list">
{% for p in collections.posts %}<a class="post-card" href="{{ p.url }}">
<div class="post-card-img"><img src="{{ p.data.image or '/assets/photos/hero-livre-dor.webp' }}" alt="" loading="lazy"></div>
<h2 class="post-card-title">{{ p.data.h1 }}</h2>
<p class="post-card-excerpt">{{ p.data.extrait }}</p>
<p class="post-card-meta">{{ site.fondateur.prenom }} {{ site.fondateur.nom }} · {{ (p.data.modifie or p.date) | dateFr }}</p>
</a>{% endfor %}
</section>
