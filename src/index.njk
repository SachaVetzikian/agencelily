{% for o in occasions %}{% set evt = evenements | findBySlug(o.evenement) %}<a href="{{ o.url }}">{% set label = o.nom %}{% set img = evt.image if evt else "" %}{% set tall = false %}{% include "partials/visual.njk" %}<span class="m-cap">{{ o.nom }}</span></a>{% endfor %}
</div>
</div></section>

<section class="section alt"><div class="wrap">
<div class="section-title"><span class="eyebrow">FAQ</span><h2>Questions fréquentes</h2></div>
