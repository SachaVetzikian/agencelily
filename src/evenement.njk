---
layout: layouts/base.njk
pagination:
  data: evenements
  size: 1
  alias: e
permalink: "/evenements/{{ e.slug }}/"
---
{% set crumbs = [{ nom: "Événements", url: "/evenements/" }, { nom: e.nom }] %}
{% include "partials/crumbs.njk" %}

<section class="hero service-hero">
<div class="wrap grid">
<div>
<span class="eyebrow">{{ e.nom }} · {{ site.zone }}</span>
<h1>{{ e.h1 }}</h1>
<p class="lede">{{ e.accroche }}</p>
<div class="btns"><a class="btn" href="/devis/?evenement={{ e.slug }}">Demander un devis</a><a class="btn ghost" href="#pack">Voir le pack</a></div>
</div>
{% set label = e.nom %}{% set img = e.image %}{% set tall = true %}{% include "partials/visual.njk" %}
</div>
</section>

<section class="section alt">
<div class="wrap" style="max-width:820px;">
<h2>Ce qui compte pour {{ e.unNom }}</h2>
<p class="lede" style="max-width:none;">{{ e.enjeu }}</p>
</div>
</section>

<section class="section">
<div class="wrap">
<h2>Nos recommandations</h2>
<div class="reco" style="margin-top:24px;">
{% for r in e.services %}{% set x = services | findBySlug(r.slug) %}<a href="/{{ x.categorie }}/{{ x.slug }}/"><div><span class="tag">{% if x.categorie == 'animations' %}Bar gourmand{% else %}Location{% endif %}</span><h3 style="margin:4px 0 0;">{{ x.nom }}</h3><p>{{ r.pourquoi }}</p></div><span class="price" style="padding:0;white-space:nowrap;">Dès {{ x.prix | euros }}</span></a>
{% endfor %}
</div>
</div>
</section>

<section class="section" id="pack" style="padding-top:0;">
<div class="wrap">
<div class="pack">
<div>
<span class="eyebrow">Le plus simple</span>
<h2>{{ e.pack.nom }}</h2>
<ul class="check">{% for c in e.pack.contenu %}<li>{{ c }}</li>{% endfor %}</ul>
</div>
<div>
<div class="amount"><s>{{ e.pack.valeur | euros }}</s>{{ e.pack.prix | euros }}</div>
<p>Un seul devis, une seule équipe, {{ e.pack.valeur - e.pack.prix }} € d'économie.</p>
<a class="btn" href="/devis/?evenement={{ e.slug }}&pack=1">Réserver ce pack</a>
</div>
</div>
</div>
</section>

<section class="section alt">
<div class="wrap" style="max-width:820px;">
<h2>Vos questions</h2>
{% set faq = e.faq %}{% include "partials/faq.njk" %}
</div>
</section>

<section class="section">
<div class="wrap">
<h2>Autres événements</h2>
<div class="pills" style="margin-top:20px;">{% for o in evenements %}{% if o.slug != e.slug %}<a class="pill" href="/evenements/{{ o.slug }}/">{{ o.nom }}</a>{% endif %}{% endfor %}</div>
</div>
</section>

{% set devisParam = "evenement=" + e.slug %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in e.faq %}{"@type":"Question","name":{{ f.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Accueil","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Événements","item":"{{ site.url }}/evenements/"},{"@type":"ListItem","position":3,"name":{{ e.nom | json | safe }}}]}
</script>
